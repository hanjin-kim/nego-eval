# Copy to .env and fill in. .env is gitignored; this file must never hold a
# real value.
#
#   cp .env.example .env
#   $EDITOR .env
#
# No key is needed for anything except the language-model buyers. Every
# scripted policy, the learned baseline, the dynamic-programming optimum and
# the whole test suite run with no key at all, and that stays true.

# OpenRouter, for the language-model buyers. Models with a "/" in the name are
# routed here.
OPEN_ROUTER_API_KEY=

# Alibaba DashScope, OpenAI-compatible. Used for bare model names.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
